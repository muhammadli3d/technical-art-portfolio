---
import { withBase } from '~/lib/url';
import TagList from './TagList.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  cover: string;
  coverAlt: string;
  role: string;
  year: number;
  tools: readonly string[];
  eager?: boolean;
}

const { href, title, summary, cover, coverAlt, role, year, tools, eager = false } = Astro.props;
const coverSrc = withBase(cover);
---

<a
  href={href}
  class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-border-base bg-bg-elevated text-fg-base no-underline shadow-hairline transition-colors hover:border-accent-500/60"
>
  <div class="aspect-[16/10] overflow-hidden bg-bg-muted">
    <img
      src={coverSrc}
      alt={coverAlt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
    />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-center justify-between gap-3">
      <h3 class="text-lg font-semibold">{title}</h3>
      <span class="font-mono text-xs text-fg-subtle">{year}</span>
    </div>
    <p class="text-sm text-fg-muted">{summary}</p>
    <div class="mt-auto pt-2">
      <TagList role={role} tools={tools.slice(0, 3)} />
    </div>
  </div>
</a>
