---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'prose prose-invert max-w-none',
    'prose-headings:tracking-tight prose-headings:text-fg-base',
    'prose-p:text-fg-muted',
    'prose-a:text-accent-400 hover:prose-a:text-accent-500',
    'prose-strong:text-fg-base',
    'prose-code:rounded prose-code:bg-bg-elevated prose-code:px-1 prose-code:py-0.5 prose-code:font-mono prose-code:text-fg-base prose-code:before:content-none prose-code:after:content-none',
    'prose-pre:rounded-xl prose-pre:border prose-pre:border-border-base prose-pre:bg-bg-elevated',
    'prose-hr:border-border-base',
    'prose-li:text-fg-muted',
    className,
  ]}
>
  <slot />
</div>
