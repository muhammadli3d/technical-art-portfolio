---
import { site } from '~/lib/site';
import { withBase } from '~/lib/url';

const home = withBase('/');
const resume = withBase(`/${site.resumeHref}`);
---

<header class="sticky top-0 z-50 border-b border-border-base/60 bg-bg-base/80 backdrop-blur">
  <div class="container-content flex h-14 items-center justify-between">
    <a href={home} class="font-mono text-sm font-medium text-fg-base no-underline hover:text-accent-400">
      {site.name.toLowerCase().replace(/\s+/g, '_')}
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-5 text-sm">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} class="text-fg-muted no-underline hover:text-fg-base">
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={resume}
            class="chip !text-fg-base hover:!border-accent-500 hover:!text-accent-400 no-underline"
          >
            Resume
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
